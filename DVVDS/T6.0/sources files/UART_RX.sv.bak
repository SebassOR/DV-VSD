module uart_rx #(
    parameter int    CLKS_PER_BIT = 5,      
    parameter string PARITY_MODE  = "NONE"
) (
    input  logic       clk,
    input  logic       rst,            
    input  logic       rx,            
 
    output logic [7:0] rx_data,        
    output logic       received,      
    output logic       parity_error                    
);

    typedef enum logic [2:0] {
        S_IDLE,
        S_START,
        S_DATA,
        S_PARITY,
        S_STOP,
        S_CLEANUP
    } state_t;
    state_t state;
    
    localparam int CNT_W = (CLKS_PER_BIT <= 1) ? 1 : $clog2(CLKS_PER_BIT);
    logic [CNT_W-1:0] clk_count;   
    logic [2:0]       bit_index;   
    logic [7:0]       rx_shift;   
    logic rx_sync0, rx_sync1;
    wire  rx_bit = rx_sync1;

    always_ff @(posedge clk) begin
        if (rst) begin
            rx_sync0 <= 1'b1;
            rx_sync1 <= 1'b1;
        end else begin
            rx_sync0 <= rx;
            rx_sync1 <= rx_sync0;
        end
    end

    always_ff @(posedge clk) begin
        if (rst) begin
            state        <= S_IDLE;
            clk_count    <= '0;
            bit_index    <= '0;
            rx_shift     <= '0;
            rx_data      <= '0;
            received     <= 1'b0;
            parity_error <= 1'b0;
        end else begin
            received     <= 1'b0;
            case (state)
                S_IDLE: begin
                    clk_count <= '0;
                    bit_index <= '0;
                    if (rx_bit == 1'b0)      
                        state <= S_START;
                end
                S_START: begin
                   if (clk_count == (CLKS_PER_BIT-1)/2) begin
                        if (rx_bit == 1'b0) begin
                            clk_count <= '0;
                            state     <= S_DATA;
                        end else begin
                            state <= S_IDLE;  
                        end
                    end else begin
                        clk_count <= clk_count + 1'b1;
                    end
                end
                S_DATA: begin
                    if (clk_count < CLKS_PER_BIT-1) begin
                        clk_count <= clk_count + 1'b1;
                    end else begin
                        clk_count <= '0;
                        rx_shift  <= {rx_bit, rx_shift[7:1]};

                        if (bit_index < 3'd7) begin
                            bit_index <= bit_index + 1'b1;
                        end else begin
                            bit_index <= '0;
                            state <= (PARITY_MODE == "NONE") ? S_STOP : S_PARITY;
                        end
                    end
                end
                S_PARITY: begin
                if (clk_count < CLKS_PER_BIT-1) begin
                        clk_count <= clk_count + 1'b1;
                    end else begin
                        clk_count <= '0;
                        if (PARITY_MODE == "EVEN")
                            parity_error <= (^{rx_shift, rx_bit}) != 1'b0;
                        else 
                            parity_error <= (^{rx_shift, rx_bit}) != 1'b1;
                        state <= S_STOP;
                    end    
                end
                S_STOP: begin
                  if (clk_count < CLKS_PER_BIT-1) begin
                        clk_count <= clk_count + 1'b1;
                    end else begin
                        clk_count <= '0;
                        rx_data <= rx_shift;
                        state  <= S_CLEANUP;
                    end
                end
                S_CLEANUP: begin
                    received <= 1'b1;   
                    state    <= S_IDLE; 
                end
                default: state <= S_IDLE;
            endcase
        end
    end
endmodule


// ============================================================================
// 2. LA INTERFAZ
// ============================================================================
interface uart_if (
    input logic clk,
    input logic rst
);
    logic       rx;
    logic [7:0] rx_data;
    logic       received;
    logic       parity_error;
endinterface


// ============================================================================
// 3. EL WRAPPER (Único puerto es la interfaz)
// ============================================================================
module uart_wrapper #(
    parameter int    CLKS_PER_BIT = 5,
    parameter string PARITY_MODE  = "ODD"
)(
    uart_if vif
);
    // Instanciamos el modulo original conectándolo solo a la interfaz
    uart_rx #(
        .CLKS_PER_BIT(CLKS_PER_BIT),
        .PARITY_MODE(PARITY_MODE)
    ) dut_rx (
        .clk(vif.clk),
        .rst(vif.rst),
        .rx(vif.rx),
        .rx_data(vif.rx_data),
        .received(vif.received),
        .parity_error(vif.parity_error)
    );
endmodule


// ============================================================================
// 4. EL ENTORNO DE VERIFICACIÓN (TESTBENCH)
// ============================================================================

// A. Clase Objeto para cumplir con el 10% Extra (Object is used to test)
class UartTransaction;
    logic [7:0] data;
    logic       parity_bit;

    // Función para calcular la paridad Impar (ODD parity)
    function void calc_odd_parity();
        // Si hay cantidad par de 1s, el bit de paridad debe ser 1
        // Si hay cantidad impar de 1s, el bit de paridad debe ser 0
        parity_bit = ~(^data); 
    endfunction
endclass

// B. Módulo del Testbench
module tb_uart_rx;

    // Señales de control
    logic clk;
    logic rst;

    // Constantes del test
    localparam int CLKS_PER_BIT = 5;
    localparam string PARITY_MODE = "ODD";

    // Instancia de la interfaz
    uart_if vif(.clk(clk), .rst(rst));

    // Instancia del Wrapper
    uart_wrapper #(
        .CLKS_PER_BIT(CLKS_PER_BIT),
        .PARITY_MODE(PARITY_MODE)
    ) wrapper_inst (
        .vif(vif)
    );

    // Generador de Reloj
    initial begin
        clk = 0;
        forever #5 clk = ~clk; // Periodo de 10 unidades de tiempo
    end

    // Task para emular la transmisión a través de la interfaz
    task send_uart_frame(input UartTransaction tr);
        // Start bit (0)
        vif.rx = 1'b0;
        repeat(CLKS_PER_BIT) @(posedge clk);

        // Data bits (LSB first, tal como configuraste tu SIPO)
        for (int i = 0; i < 8; i++) begin
            vif.rx = tr.data[i];
            repeat(CLKS_PER_BIT) @(posedge clk);
        end

        // Parity bit
        vif.rx = tr.parity_bit;
        repeat(CLKS_PER_BIT) @(posedge clk);

        // Stop bit (1)
        vif.rx = 1'b1;
        repeat(CLKS_PER_BIT) @(posedge clk);
    endtask

    // Task para checar el resultado automáticamente (10% Extra: Auto-check pass-fail)
    task check_uart_frame(input UartTransaction tr);
        // Esperamos a que el módulo nos diga que ya recibió el byte
        @(posedge vif.received);

        // Auto-check comparando lo enviado vs lo recibido
        if (vif.rx_data === tr.data && vif.parity_error === 1'b0) begin
            $display("=================================================");
            $display("[PASS] Datos correctos.");
            $display("Enviado: %b | Recibido: %b", tr.data, vif.rx_data);
            $display("=================================================");
        end else begin
            $display("=================================================");
            $display("[FAIL] Error en la recepcion.");
            $display("Enviado: %b | Recibido: %b | Error Paridad: %b", tr.data, vif.rx_data, vif.parity_error);
            $display("=================================================");
        end
    endtask

    // Bloque Inicial de la simulación
    initial begin
        // Objeto que se utilizará para testear
        UartTransaction tr = new();

        // Inicialización y Reset
        vif.rx = 1'b1; // UART Idle state = 1
        rst = 1;
        #20;
        rst = 0;
        #20;

        $display("\n--- INICIANDO TEST CON PARIDAD IMPAR (ODD) ---");

        // --- TEST 1 --- (Basado en la tabla de tu tarea)
        tr.data = 8'b01101001; // Data = 01101001 (4 bits en 1)
        tr.calc_odd_parity();  // El bit de paridad deberia ser 1
        
        // Ejecutamos el envío y la comprobación de forma paralela (fork-join)
        fork
            send_uart_frame(tr);
            check_uart_frame(tr);
        join

        #50;

        // --- TEST 2 ---
        tr.data = 8'b01010001; // Data = 01010001 (3 bits en 1)
        tr.calc_odd_parity();  // El bit de paridad deberia ser 0
        
        fork
            send_uart_frame(tr);
            check_uart_frame(tr);
        join
        
        #100;
        $display("Simulacion Terminada.");
        $finish;
    end

endmodule